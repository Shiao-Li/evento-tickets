# --- Base de datos (Neon: pooled en DATABASE_URL, directa en DIRECT_URL; si usas una sola, repítela) ---
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# --- Secretos (genera cada uno con el comando indicado) ---
AUTH_SECRET=""        # openssl rand -base64 32
TICKET_SECRET=""      # openssl rand -hex 32   (firma HMAC de los QR; si lo cambias, los QR emitidos dejan de ser válidos)

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="Entradas <entradas@tudominio.com>"   # con onboarding@resend.dev solo puedes enviar a tu propio correo

# --- Comprobantes (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=""

# --- URL pública (para links en emails). En Vercel se detecta sola si la omites. ---
APP_URL="http://localhost:3000"

# --- Opcional ---
CRON_SECRET=""                       # protege /api/cron/expire
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="cambia-esto-123"
